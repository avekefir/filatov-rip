<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавление этапа</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="add-container">
    {{#if stage}}
      <h1>Черновик этапа</h1>
      <form>
        <div class="form-group">
          <label>Фото</label>
          <input type="file" accept="image/*" class="file-input" />
          <div class="media-preview">
            <img src="{{imageUrl}}" alt="изображение" />
          </div>
        </div>
        <div class="form-group">
          <label>Видео</label>
          <input type="file" accept="video/*" class="file-input" />
          <div class="media-preview">
            <video src="{{videoUrl}}" controls></video>
          </div>
        </div>
        <div class="form-group">
          <label>Название этапа</label>
          <input type="text" placeholder="Введите название этапа" />
        </div>
        <div class="form-group">
          <label>Описание</label>
          <textarea placeholder="Введите описание этапа"></textarea>
        </div>
        <div class="form-group">
          <label>Стоимость за час (₽/час)</label>
          <input type="number" placeholder="Например, 1500" />
        </div>
        <div class="form-group">
          <label>Максимальный размер команды (чел)</label>
          <input type="number" placeholder="Например, 5" />
        </div>
      </form>
    {{else}}
      <p>Черновик не найден</p>
    {{/if}}
  </div>
  {{> navbar active="add"}}
</body>
</html>