<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавление этапа</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="add-container">
    {{#if stage}}
      <!-- ЭТАП 2: Черновик создан (публикация) -->
      <h1>Публикация этапа</h1>
      <form>
        <div class="form-group">
          <label>Название этапа</label>
          <input type="text" value="{{stage.stageName}}" disabled />
        </div>
        <div class="form-group">
          <label>Описание</label>
          <textarea placeholder="Введите описание этапа"></textarea>
        </div>
        <div class="form-group">
          <label>Стоимость за час (₽/час)</label>
          <input type="number" placeholder="Например, 1500" />
        </div>
        <div class="form-group">
          <label>Максимальный размер команды (чел)</label>
          <input type="number" placeholder="Например, 5" />
        </div>
      </form>
      
      <!-- Кнопка публикации (красная) -->
      <form action="/development_stages/publish" method="POST">
        <input type="hidden" name="id" value="{{stage.id}}" />
        <button type="submit" class="publish-btn">Опубликовать</button>
      </form>

    {{else}}
      <!-- ЭТАП 1: Черновика нет (создание) -->
      <h1>Создание черновика</h1>
      <form action="/development_stages/add" method="POST">
        <div class="form-group">
          <label>Фото</label>
          <input type="file" accept="image/*" class="file-input" />
          <div class="media-preview">
            <img src="/default/image.jpg" alt="изображение" />
          </div>
        </div>
        <div class="form-group">
          <label>Видео</label>
          <input type="file" accept="video/*" class="file-input" />
          <div class="media-preview">
            <video src="/default/video.mp4" controls></video>
          </div>
        </div>
        <div class="form-group">
          <label>Название этапа</label>
          <input type="text" name="stageName" placeholder="Введите название этапа" required />
        </div>
        
        <button type="submit" class="next-step-btn">Далее</button>
      </form>
    {{/if}}
  </div>
  {{> navbar active="add"}}
</body>
</html>