<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавление этапа</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="add-container">
    {{#if stage}}
      <h1>Черновик этапа</h1>
      <form>
        <div class="form-group">
          <label>Фото</label>
          <input type="file" accept="image/*" class="file-input" />
          <div class="media-preview">
            <img src="{{imageUrl}}" alt="изображение" />
          </div>
        </div>
        <div class="form-group">
          <label>Видео</label>
          <input type="file" accept="video/*" class="file-input" />
          <div class="media-preview">
            <video src="{{videoUrl}}" controls></video>
          </div>
        </div>
        <div class="form-group">
          <label>Название этапа</label>
          <input type="text" value="{{stage.stageName}}" />
        </div>
        <div class="form-group">
          <label>Описание</label>
          <textarea>{{stage.stageDescription}}</textarea>
        </div>
        <div class="form-group">
          <label>Стоимость за час (₽/час)</label>
          <input type="number" value="{{stage.costPerHour}}" />
        </div>
        <div class="form-group">
          <label>Максимальный размер команды (чел)</label>
          <input type="number" value="{{stage.maxTeamSize}}" />
        </div>
      </form>

      <!-- Кнопка публикации (требуется для Lab 2 — смена статуса через ORM) -->
      <form action="/development_stages/publish" method="POST">
        <input type="hidden" name="id" value="{{stage.id}}" />
        <button type="submit" class="publish-btn">Опубликовать</button>
      </form>
    {{else}}
      <h1>Создание черновика</h1>
      <p>У вас пока нет черновика. Нажмите «Далее», чтобы создать новый этап.</p>
      <form action="/development_stages/add" method="POST">
        <div class="form-group">
          <label>Фото</label>
          <input type="file" accept="image/*" class="file-input" />
          <div class="media-preview">
            <img src="/default/image.jpg" alt="изображение" />
          </div>
        </div>
        <div class="form-group">
          <label>Видео</label>
          <input type="file" accept="video/*" class="file-input" />
          <div class="media-preview">
            <video src="/default/video.mp4" controls></video>
          </div>
        </div>
        <div class="form-group">
          <label>Название этапа</label>
          <input type="text" name="stageName" placeholder="Введите название этапа" />
        </div>
        <div class="form-group">
          <label>Описание</label>
          <textarea name="stageDescription" placeholder="Введите описание этапа"></textarea>
        </div>
        <div class="form-group">
          <label>Стоимость за час (₽/час)</label>
          <input type="number" name="costPerHour" placeholder="Например, 1500" />
        </div>
        <div class="form-group">
          <label>Максимальный размер команды (чел)</label>
          <input type="number" name="maxTeamSize" placeholder="Например, 5" />
        </div>
        <button type="submit" class="next-step-btn">Далее</button>
      </form>
    {{/if}}
  </div>
  {{> navbar active="add"}}
</body>
</html>