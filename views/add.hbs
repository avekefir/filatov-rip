<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Добавление этапа</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="add-container">
    {{#if stage}}
      <h1>Черновик этапа</h1>
      <form>
        <div class="form-group">
          <label>Изображение</label>
          <div class="media-preview"><img src="{{imageUrl}}" alt="изображение" /></div>
        </div>
        <div class="form-group">
          <label>Видео</label>
          <div class="media-preview"><video src="{{videoUrl}}" controls></video></div>
        </div>
        <div class="form-group">
          <label>Название этапа</label>
          <input type="text" placeholder="Введите название этапа" />
        </div>
        <div class="form-group">
          <label>Описание</label>
          <textarea placeholder="Введите описание этапа"></textarea>
        </div>
        <div class="form-group">
          <label>Трудоёмкость (часы)</label>
          <input type="number" placeholder="Например, 40" />
        </div>
        <div class="form-group">
          <label>Ставка (₽/час)</label>
          <input type="number" placeholder="Например, 1500" />
        </div>
        <div class="form-group">
          <label>Стоимость этапа (₽)</label>
          <input type="number" placeholder="Например, 60000" />
        </div>
        <div class="form-group">
          <label>Размер команды (чел)</label>
          <input type="number" placeholder="Например, 2" />
        </div>
        <div class="form-group">
          <label>Длительность (дни)</label>
          <input type="number" placeholder="Например, 10" />
        </div>
        <button type="button" disabled>Опубликовать</button>
      </form>
    {{else}}
      <p>Черновик не найден</p>
    {{/if}}
  </div>
  {{> navbar active="add"}}
</body>
</html>