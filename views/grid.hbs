<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Этапы разработки</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="grid-container">
    <h1>Этапы разработки ПО</h1>
    <form action="/development_stages/grid" method="GET" class="filter-form">
      <div class="range-group">
        <label>
          Стоимость за час до:
          <span class="range-value">{{#if maxCostPerHour}}{{maxCostPerHour}}{{else}}3000{{/if}} ₽/ч</span>
        </label>

        <div class="slider-wrapper">
          <input
            type="range"
            name="maxCostPerHour"
            min="0"
            max="3000"
            step="100"
            value="{{#if maxCostPerHour}}{{maxCostPerHour}}{{else}}3000{{/if}}"
          />
          <div class="slider-ticks">
            <span>0</span>
            <span>500</span>
            <span>1000</span>
            <span>1500</span>
            <span>2000</span>
            <span>2500</span>
            <span>3000</span>
          </div>
        </div>
      </div>

      <button type="submit">Применить</button>
    </form>

    <div class="grid-cards">
      {{#each stages}}
        <div class="card">
          <a href="/development_stages/feed/{{this.id}}">
            <img src="{{this.imageUrl}}" alt="{{this.stageName}}" />
            <div class="card-info">
              <h3>{{this.stageName}}</h3>
              <p>❤️ {{this.likesCount}}</p>
              <p class="cost">Стоимость за час: {{this.costPerHour}} ₽/ч</p>
              <p class="cost">Макс. команда: {{this.maxTeamSize}} чел</p>
            </div>
          </a>
        </div>
      {{else}}
        <p>Нет опубликованных этапов</p>
      {{/each}}
    </div>
  </div>
  {{> navbar active="grid"}}
</body>
</html>